APP_ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173

# Three DB identities. Passwords are set by infrastructure/sql/001_roles.sql.
DATABASE_URL=postgresql+psycopg://chatbot_app:CHANGE_ME@localhost:5432/chatbot
READONLY_DATABASE_URL=postgresql+psycopg://chatbot_readonly:CHANGE_ME@localhost:5432/chatbot
MIGRATOR_DATABASE_URL=postgresql+psycopg://chatbot_migrator:CHANGE_ME@localhost:5432/chatbot
REDIS_URL=redis://localhost:6379/0

JWT_SECRET=CHANGE_ME_generate_with_openssl_rand_hex_32
ACCESS_TOKEN_EXPIRE_MINUTES=30

OPENAI_API_KEY=
OPENAI_MODEL_ROUTER=
OPENAI_MODEL_SQL=
OPENAI_MODEL_RESPONSE=
OPENAI_MODEL_MEMORY=

MAX_RESULT_ROWS=1000
DEFAULT_QUERY_LIMIT=100
QUERY_TIMEOUT_MS=5000
RATE_LIMIT_PER_MINUTE=60
